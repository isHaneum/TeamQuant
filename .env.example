KIS_MODE=vps
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# New applications: NAVER API HUB (NAVER Cloud Platform)
NAVER_NEWS_PROVIDER=hub
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Owner-only balance endpoint; random password >=32 chars, never put in frontend
KIS_OWNER_ACCESS_TOKEN=

# Local-only Toss key file (client_id / client_secret). Not uploaded to Vercel.
TOSS_KEY_FILE=

# Optional absolute directory OUTSIDE the project; default is OS user data.
TEAMQUANT_HISTORY_DIR=

# Real KIS account, READ-ONLY record (decision 22, 2026-11-12). Set to 1 to let the PC server query the real
# account named by the LIVE labels (appkey / app / KIS_ACCOUNT_NO) of the same KIS_KEY_FILE. Inquiry only:
# the reader has no order/cancel function and never writes into process.env; orders stay on the mock account.
KIS_REAL_READONLY=
