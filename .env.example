KIS_MODE=vps
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=01

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# New applications: NAVER API HUB (NAVER Cloud Platform)
NAVER_NEWS_PROVIDER=hub
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Owner-only balance endpoint; random password >=32 chars, never put in frontend
