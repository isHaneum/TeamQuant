{
  "cleanUrls": true,
  "functions": {
    "api/stocks.js": {
      "includeFiles": "data/stocks.json"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}