{
  "cleanUrls": true,
  "functions": {
    "api/dart.js": {
      "includeFiles": "data/stocks.json"
    },
    "api/stocks.js": {
      "includeFiles": "data/stocks.json"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https:; connect-src 'self' http://127.0.0.1:8766; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "issue-data": false
    }
  },
  "redirects": [
    {
      "source": "/lib/:name(cash-store|consent|dart|device-store|fundamentals|history-model|history-recorder|history-store|investment-store|issue-feed|issue-watch|key-files|kis|kis-orders|kis-reader|local-bridge|local-launcher|local-status|market|market-overview|news|order-guard|paper-benchmark|paper-chain|paper-integrity|paper-live|performance-store|private-account|quote-check|real-record|research-job|risk-budget|situation-study|stocks|structure-cards|thesis-cards|toss|toss-ledger|toss-orders|toss-record-reader|vault).js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(dev-server|launch-personal-server).mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
