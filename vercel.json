{
  "cleanUrls": true,
  "functions": {
    "api/dart.js": {
      "includeFiles": "data/stocks.json"
    },
    "api/stocks.js": {
      "includeFiles": "data/stocks.json"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "issue-data": false
    }
  },
  "redirects": [
    {
      "source": "/lib/:name(cash-store|dart|device-store|fundamentals|history-model|history-recorder|history-store|investment-store|issue-feed|key-files|kis|kis-orders|local-bridge|local-launcher|local-status|market|news|order-guard|paper-integrity|paper-live|performance-store|private-account|quote-check|research-job|situation-study|stocks|toss-orders|toss).js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(dev-server|launch-personal-server).mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.github/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
